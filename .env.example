# Optional live-model configuration. Offline mode does not need an API key.
# Copy this file to .env and set just one provider and its required values.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# Set the matching key for the selected provider:
OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# For an OpenAI-compatible endpoint:
# LLM_PROVIDER=custom
# LLM_MODEL=your-model-name
# CUSTOM_BASE_URL=https://your-endpoint/v1
# CUSTOM_API_KEY=

# For local Ollama:
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434

# Optional separate judge model settings:
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=gpt-4o-mini

# Memory tuning:
COMPACT_THRESHOLD_TOKENS=1800
COMPACT_KEEP_MESSAGES=6
# STATE_DIR=state
